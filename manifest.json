{
  "name": "starline-obsidian-archive",
  "version": "1.4.0",
  "owner": "墨点星痕 (starline)",
  "author": {
    "name": "墨点星痕",
    "english_name": "starline"
  },
  "updated_at": "2026-09-18",
  "status": "active",
  "maturity_tier": "library",
  "lifecycle_stage": "library",
  "context_budget_tier": "library",
  "review_cadence": "quarterly",
  "skill_ir_source": "reports/skill-ir.json",
  "factory_components": ["references", "scripts", "evals", "templates", "reports"],
  "upstream_inspiration": "https://github.com/openclaw/openclaw/tree/main/extensions/memory-wiki/skills/obsidian-vault-maintainer; https://github.com/kepano/obsidian-skills/tree/main/skills/obsidian-markdown; https://github.com/xhonye/AI-Context-Linker; https://github.com/mithunyc/obsidian-agent-memory; https://github.com/cobibean/agent-memory-wiki; https://github.com/stefan-jansen/coding-agent-toolkit",
  "intent": {
    "job": "维护一个可供人和多个 Agent 共同使用的 Obsidian 长期记忆与本地资料档案：按层级拉取相关上下文、只同步耐久且已验证的结论，并在用户批准时生成非破坏索引、结构审计或单文件上下文简报。",
    "target_users": [
      "需要长期维护本地创作、媒体或项目档案的 Obsidian 用户",
      "需要让 Codex、Claude、VSCode 或其他 Agent 共享项目结论的用户",
      "需要把已审核项目资料编译为 ChatGPT 或其他 Agent 可直接读取的简报的用户"
    ],
    "inputs": [
      "运行时指定的 Obsidian Vault 路径",
      "用户批准的来源目录或 Markdown 文件白名单",
      "项目记忆、可复用知识和会话摘要",
      "可选的跨客户端长期记忆规则请求"
    ],
    "outputs": [
      "Memory Pull/Push 结果与证据状态",
      "链接权威笔记的会话摘要",
      "资源总览、分组笔记和资源清单 JSON",
      "Vault 结构审计 Markdown/JSON",
      "ai_context.md 和 context-manifest.json"
    ],
    "exclusions": [
      "原始文件迁移、删除或无确认改名",
      "未授权全盘或递归项目扫描",
      "云端同步、实时聊天桥接和原始聊天归档",
      "图片生成、语义质量判断和凭据收集"
    ]
  },
  "target_platforms": ["openai", "claude", "generic", "agent-skills-compatible", "vscode"],
  "release_gates": [
    "validate_skill",
    "governance_check",
    "trigger_eval",
    "skill_ir",
    "prior_art_research",
    "source_boundary_review",
    "memory_tools_tests",
    "utf8_and_wikilink_verification"
  ],
  "capabilities": {
    "memory_coordination": true,
    "approved_archive": true,
    "vault_structure_audit": true,
    "context_brief": true,
    "raw_chat_capture": false,
    "cloud_upload": false
  },
  "starline_defaults": {
    "skill_name_prefix": "starline-",
    "author_name": "墨点星痕",
    "author_english_name": "starline",
    "frontmatter_author": "墨点星痕 (starline)"
  },
  "naming": {
    "default_prefix": "starline-",
    "max_preferred_hyphen_parts": 3,
    "allow_user_prefix_override": true,
    "allow_no_prefix": true
  }
}
